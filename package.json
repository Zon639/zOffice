{
  "name": "quan-ly-cong-viec-zalo",
  "version": "1.1.0",
  "description": "zOffice - Ứng dụng Quản lý Văn bản & Công việc trên Windows tích hợp Zalo (zca-js)",
  "repository": "Zon639/zOffice",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "release": "node scripts/release.js",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [
    "zalo",
    "zca-js",
    "quan-ly-van-ban",
    "quan-ly-cong-viec",
    "electron"
  ],
  "author": "zOffice",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "zca-js": "^2.2.0"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.zoffice.app",
    "productName": "zOffice",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "apps-script/**/*",
      "package.json",
      "z.ico",
      "z.png",
      "!data/**/*",
      "!test/**/*",
      "!scripts/**/*",
      "!build/**/*"
    ],
    "extraResources": [
      {
        "from": "build/addin",
        "to": "addin"
      },
      "z.ico",
      "z.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "z.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "zOffice",
      "artifactName": "zOffice-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    }
  }
}
